# .htaccess for Healing Therapy Center

# 1. Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# 2. Block access to sensitive files
<FilesMatch "(error_log|\.zip|\.env|\.git)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# 3. Custom Error Pages
# The live host overrides these (every error comes back as a bare "404 Not Found"), so
# missing pages and blocked paths are routed to /404.php by the rewrite rules below instead.
# Kept for other servers and for 403/500.
ErrorDocument 404 /404.php
ErrorDocument 403 /404.php
ErrorDocument 500 /404.php

RewriteEngine On

# Apache re-runs these rules on its own internal redirects (the ErrorDocument page and the
# clean-URL -> .php rewrite at the bottom). Only the browser's original request may be
# redirected; otherwise an error page gets redirected too (a 404 for /x.php became a 301 to /404).
RewriteCond %{ENV:REDIRECT_STATUS} !^$
RewriteRule ^ - [L]

# 4. Keep repo-only files off the public site. The whole project folder gets uploaded,
#    so without this the docs, tooling, old HTML backups (with the old address), PHP
#    partials, the dev router, SEO/CSV exports and the form handlers' rate-limit files
#    (which hold recent visitors' IP addresses) are all publicly downloadable.
#    They get the site's 404 page (404.php sends the 404 status itself). The bare folder
#    names answer 404 directly, before Apache's add-a-trailing-slash redirect can reveal them.
RewriteRule ^(docs|scripts|backup-html-originals|includes)$ - [R=404,L]
RewriteRule ^(docs|scripts|backup-html-originals|includes)/ /404.php [L]
RewriteRule ^(router\.php|\.gitignore)$ /404.php [L]
RewriteRule ^forms/.+\.txt$ /404.php [L]
RewriteRule \.(md|csv|py|sh|zip|log)$ /404.php [L]

# 5. Legacy and duplicate URLs -> the canonical https://www clean URL in ONE hop.
#    These run before the protocol/host rule below so that http:// and non-www
#    legacy URLs no longer chain through two or three redirects.

# Renamed pages (old typo URLs)
RewriteRule ^coping-with-postpartum-pepression(\.html)?$ https://www.healingtherapycenter.com/coping-with-postpartum-depression [L,R=301]
RewriteRule ^is-austim-curable(\.html)?$ https://www.healingtherapycenter.com/is-autism-curable [L,R=301]
RewriteRule ^tiffany-murray(\.html)?$ https://www.healingtherapycenter.com/dr-tiffany-murray [L,R=301]

# Homepage aliases (/index, /index.php, /index.html) -> /
# THE_REQUEST (the browser's own request line) keeps this from firing on Apache's
# internal DirectoryIndex lookup of index.php, which would loop.
RewriteCond %{THE_REQUEST} ^[A-Z]+\ /index(\.php|\.html)?/?[?\ ]
RewriteRule ^ https://www.healingtherapycenter.com/ [L,R=301]

# .html -> clean URL (except Google verification files), e.g. /appointment.html -> /appointment
RewriteCond %{THE_REQUEST} ^[A-Z]+\ /[^\ ?]+\.html[?\ ]
RewriteCond %{REQUEST_URI} !^/google[a-zA-Z0-9]+\.html$ [NC]
RewriteRule ^(.+)\.html$ https://www.healingtherapycenter.com/$1 [L,R=301]

# .php -> clean URL for top-level pages, e.g. /appointment.php -> /appointment.
# Only the browser's own GET/HEAD requests; the form handlers live in /forms/ and are untouched.
RewriteCond %{THE_REQUEST} ^(GET|HEAD)\ /[^/\ ?]+\.php[?\ ]
RewriteRule ^([^/]+)\.php$ https://www.healingtherapycenter.com/$1 [L,R=301]

# Trailing slash -> no trailing slash (anything that isn't a real directory).
# Previously /page/ looped internally (page/.php, page/.php.php, ...) and returned a 500.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ https://www.healingtherapycenter.com/$1 [L,R=301]

# 6. Canonical protocol + host: http:// or the bare domain -> https://www, in one hop
#    (previously http://healingtherapycenter.com went to https://healingtherapycenter.com
#    first, then to www). SSL certificate validation requests are left alone.
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^healingtherapycenter\.com$ [NC]
RewriteRule ^ https://www.healingtherapycenter.com%{REQUEST_URI} [L,R=301]

# 7. Serve clean URLs from their .php file (then legacy .html). Top-level slugs only,
#    so a stray slash or dot can never feed the rewrite back into itself.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/.]+)$ $1.php [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/.]+)$ $1.html [L,QSA]

# 8. Any other page that doesn't exist: the site's 404 page instead of the host's bare
#    "404 Not Found". Missing images, scripts and other assets keep the cheap bare 404.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.(css|js|map|png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|eot|pdf|txt|xml|json)$ [NC]
RewriteRule ^ /404.php [L]

# 4c. MIME type for AVIF (required: nosniff header prevents type-guessing)
<IfModule mod_mime.c>
    AddType image/avif .avif
</IfModule>

# 5. Browser caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# 6. Gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript
</IfModule>
